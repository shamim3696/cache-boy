{
  "name": "cache-boy-client",
  "version": "0.1.2",
  "description": "TypeScript/Node.js client for cache-boy: RESP3, auto-pipelining, client-side caching, stampede-safe wrap(), locks, rate limits, queues, tags and an HTTP/edge mode.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shamim3696/cache-boy.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/shamim3696/cache-boy/blob/main/docs/guide.md",
  "bugs": "https://github.com/shamim3696/cache-boy/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --test \"dist-test/test/*.test.js\"",
    "prepublishOnly": "npm run clean && npm run build",
    "clean": "node -e \"for (const d of ['dist','dist-test']) require('node:fs').rmSync(d,{recursive:true,force:true})\""
  },
  "keywords": [
    "redis",
    "cache-boy",
    "resp3",
    "client-side-caching",
    "cache",
    "queue",
    "rate-limit",
    "lock",
    "cache-boy-client",
    "redis-client",
    "ioredis",
    "semantic-cache",
    "vector-search",
    "distributed-lock",
    "job-queue",
    "cache-stampede",
    "serverless",
    "edge"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
